PORT=5000
MONGODB_URI=mongodb://localhost:27017/nexus-work
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
NODE_ENV=development

# Email (Gmail): SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# Use a Google "App password" (16 characters, no spaces) and URL-encode the @ as %40.
# SMTP_URL=
# MAIL_FROM=you@gmail.com

# File storage on Google Drive (screenshots, recordings, attachments). Leave empty to keep files on this server.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER=NexusWork
